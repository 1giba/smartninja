---
import { hero } from '../content/home';
import HeroDiagram from './HeroDiagram.astro';
---

<section class="on-dark bg-navy text-vanilla">
  <div class="shell grid items-center gap-x-12 gap-y-10 pt-14 pb-16 sm:pt-20 lg:grid-cols-12 lg:pt-24 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="label flex items-center gap-3 text-mist">
        <span aria-hidden="true" class="size-2 bg-lime"></span>
        {hero.eyebrow}
      </p>
      <h1 class="display mt-7 text-[clamp(2.5rem,7.2vw,5.25rem)] text-white">{hero.title}</h1>
      <p class="mt-8 max-w-xl text-lg text-mist sm:text-xl">{hero.lead}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="#visao" class="btn-lime px-6 py-4">Conheça a visão</a>
        <a
          href="#contato"
          class="label py-2 underline decoration-lime decoration-2 underline-offset-8 hover:text-lime"
        >
          Fale com a SmartNinja
        </a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <HeroDiagram />
    </div>
  </div>
</section>
