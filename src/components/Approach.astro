---
import { approach, platform } from '../content/home';
import SectionLabel from './SectionLabel.astro';

const { flow } = approach;
// Ordem de platform.areas: billing, pagamentos, APIs, growth.
const [billing, payments, api, growth] = platform.areas;
const letters = ['A', 'B', 'C'];

const mark = 'label grid size-6 shrink-0 place-items-center border border-current';
const cell = 'flex min-h-16 items-center gap-3 p-4 font-display leading-tight font-semibold tracking-[-0.02em]';
const dash = 'border-dashed border-mist';
---

<section aria-labelledby="abordagem-titulo" class="py-20 lg:py-32">
  <div class="shell grid gap-x-12 gap-y-8 lg:grid-cols-12">
    <SectionLabel index="04" class="text-slate lg:col-span-3 lg:pt-3">Abordagem</SectionLabel>
    <div class="lg:col-span-9">
      <h2 id="abordagem-titulo" class="display max-w-3xl text-3xl sm:text-5xl">{approach.title}</h2>
    </div>
  </div>

  <!-- Integração: a empresa (vanilla) se liga à base (lime) pelas APIs. As
       ligações são tracejadas porque representam a proposta, não integrações
       existentes. As letras remetem aos três princípios listados abaixo. -->
  <div class="shell mt-10 lg:mt-16">
    <div class="on-dark dot-grid grid bg-navy p-5 text-vanilla sm:p-10 lg:grid-cols-[minmax(0,1fr)_6rem_minmax(0,2fr)] lg:p-12">
      <div class="flex flex-col">
        <h3 class="label flex min-h-6 items-center gap-3 text-vanilla">
          <span aria-hidden="true" class="size-2 border border-vanilla"></span>
          {flow.clientLabel}
        </h3>
        <ul class="mt-6 grid flex-1 gap-4 lg:grid-rows-2">
          <li class:list={[cell, 'bg-vanilla text-deep-navy']}>{flow.product}</li>
          <li class:list={[cell, 'border-[1.5px] border-dashed border-vanilla text-vanilla']}>{flow.systems}</li>
        </ul>
      </div>

      <div class="flex flex-col">
        <p class="sr-only">{flow.link}</p>
        <span aria-hidden="true" class:list={['mx-auto mb-5 h-12 w-0 border-l-[1.5px] lg:hidden', dash]}></span>
        <div aria-hidden="true" class="mt-12 hidden flex-1 gap-4 lg:grid lg:grid-rows-2">
          <span class:list={['self-center border-t-[1.5px]', dash]}></span>
          <span class:list={['self-center border-t-[1.5px]', dash]}></span>
        </div>
      </div>

      <div class="flex flex-col">
        <h3 class="label flex min-h-6 items-center gap-3 text-lime">
          <span class={mark}>{letters[0]}</span>
          {flow.baseLabel}
        </h3>
        <div class="mt-6 grid flex-1 gap-[2px] lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
          <p class:list={[cell, 'bg-lime text-2xl text-deep-navy lg:px-7']}>
            <span class={mark}>{letters[1]}</span>
            {api.name}
          </p>
          <ul class="grid gap-[2px]">
            {[billing, payments, growth].map((area) => <li class:list={[cell, 'bg-lime text-deep-navy']}>{area.name}</li>)}
            <li class:list={[cell, 'flex-wrap justify-between border-[1.5px] border-dashed border-lime text-lime']}>
              <span class="flex items-center gap-3">
                <span class={mark}>{letters[2]}</span>
                {flow.ai}
              </span>
              <span class="label">{flow.aiStatus}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="shell mt-12 lg:mt-16">
    <dl class="grid border-t border-navy lg:grid-cols-3">
      {
        approach.principles.map((principle, i) => (
          <div class="grid gap-x-10 gap-y-2 border-b border-line py-7 sm:grid-cols-5 lg:block lg:border-b-0 lg:border-l lg:px-8 lg:py-8 lg:first:border-l-0 lg:first:pl-0">
            <dt class="flex items-start gap-4 font-display text-xl font-semibold tracking-[-0.02em] sm:col-span-2">
              <span aria-hidden="true" class:list={[mark, 'mt-0.5 font-mono text-lime-deep']}>
                {letters[i]}
              </span>
              {principle.name}
            </dt>
            <dd class="text-slate sm:col-span-3 lg:mt-4 lg:pl-10">{principle.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
