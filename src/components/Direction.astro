---
import { direction } from '../content/home';
import SectionLabel from './SectionLabel.astro';
---

<section aria-labelledby="direcao-titulo" class="bg-white py-20 lg:py-28">
  <div class="shell grid gap-x-12 gap-y-8 lg:grid-cols-12">
    <SectionLabel index="05" class="text-slate lg:col-span-3 lg:pt-3">Direção</SectionLabel>
    <div class="lg:col-span-9">
      <h2 id="direcao-titulo" class="display max-w-3xl text-3xl sm:text-5xl">{direction.title}</h2>
      <p class="mt-6 max-w-2xl text-lg text-slate">{direction.text}</p>
      <!-- Cada horizonte tem a própria linha: contínua para o que está em
           construção, tracejada para o que vem adiante. -->
      <ol class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2">
        {
          direction.horizons.map((horizon, i) => {
            const ahead = i > 0;
            return (
              <li>
                <p class:list={['label flex items-center gap-3 border-b-2 border-navy pb-4', ahead && 'border-dashed']}>
                  <span
                    aria-hidden="true"
                    class:list={['size-2.5 border-[1.5px] border-navy', ahead ? 'border-dashed' : 'bg-lime']}
                  />
                  {horizon.label}
                </p>
                <h3 class="mt-6 font-display text-2xl font-semibold tracking-[-0.03em] text-balance">{horizon.name}</h3>
                <p class="mt-3 text-slate">{horizon.text}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
