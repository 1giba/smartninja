---
import { vision } from '../content/home';
import SectionLabel from './SectionLabel.astro';
---

<section id="visao" aria-labelledby="visao-titulo" class="py-20 lg:py-32">
  <div class="shell grid gap-x-12 gap-y-8 lg:grid-cols-12">
    <SectionLabel index="01" class="text-slate lg:col-span-3 lg:pt-3">Visão</SectionLabel>
    <div class="lg:col-span-9">
      <h2 id="visao-titulo" class="display max-w-4xl text-3xl sm:text-5xl">{vision.title}</h2>
      <div class="mt-10 grid max-w-4xl gap-6 text-lg text-slate md:grid-cols-2 md:gap-10">
        {vision.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>

  <div class="shell mt-16 lg:mt-24">
    <ol class="grid border-t border-navy md:grid-cols-3">
      {
        vision.stages.map((stage, i) => (
          <li class="border-b border-line py-8 md:border-b-0 md:border-l md:px-8 md:first:border-l-0 md:first:pl-0">
            <span aria-hidden="true" class="label text-lime-deep">0{i + 1}</span>
            <h3 class="mt-4 font-display text-3xl font-semibold tracking-[-0.03em]">{stage.name}</h3>
            <p class="mt-3 max-w-sm text-slate">{stage.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
