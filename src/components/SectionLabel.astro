---
interface Props {
  index: string;
  class?: string;
}

const { index, class: className = '' } = Astro.props;
---

<p class:list={['label flex items-center gap-3 self-start', className]}>
  <span aria-hidden="true" class="text-lime-deep [.on-dark_&]:text-lime">{index}</span>
  <span aria-hidden="true" class="h-px w-8 bg-current opacity-40"></span>
  <slot />
</p>
